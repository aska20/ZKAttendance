# Base URL the SPA calls. Leave as /api in development to use the Vite proxy
# (see vite.config.js), which forwards to the backend and sidesteps CORS.
# In production set this to the deployed API origin, e.g. https://zkattendance-api.onrender.com
VITE_API_URL=/api

# Where the dev proxy forwards /api requests. Match your backend launch profile.
VITE_API_PROXY_TARGET=http://localhost:5107
