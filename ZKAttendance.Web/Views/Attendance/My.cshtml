@model List<ZKAttendance.Application.Dtos.AttendanceViewModel>
@{
    ViewData["Title"] = "My Attendance";
    var linked = ViewBag.EmployeeLinked as bool? ?? false;
    var fromDate = ViewBag.FromDate as string;
    var toDate = ViewBag.ToDate as string;
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1"><i class="bi bi-clipboard-data me-2"></i>My Attendance</h2>
            <p class="text-muted mb-0">@(ViewBag.EmployeeName ?? User.Identity?.Name)</p>
        </div>
    </div>

    @if (!linked)
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle me-2"></i>
            Your sign-in account is not linked to an employee record yet, so no
            attendance can be shown. Ask an administrator to set the work email
            or employee number on your employee record so the two match.
        </div>
    }
    else
    {
        <div class="row g-3 mb-4">
            <div class="col-sm-6 col-lg-3">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="text-muted small">Days with punches</div>
                        <div class="fs-3 fw-bold">@(ViewBag.TotalDays ?? 0)</div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="text-muted small">Total hours</div>
                        <div class="fs-3 fw-bold">@(((double?)ViewBag.TotalHours ?? 0).ToString("0.0"))</div>
                    </div>
                </div>
            </div>
        </div>

        <form method="get" asp-action="My" class="card border-0 shadow-sm mb-4">
            <div class="card-body row g-3 align-items-end">
                <div class="col-auto">
                    <label class="form-label small mb-1">From</label>
                    <input type="date" name="fromDate" value="@fromDate" class="form-control" />
                </div>
                <div class="col-auto">
                    <label class="form-label small mb-1">To</label>
                    <input type="date" name="toDate" value="@toDate" class="form-control" />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-funnel me-1"></i>Apply
                    </button>
                    <a asp-action="My" class="btn btn-outline-secondary">Reset</a>
                </div>
            </div>
        </form>

        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Date</th>
                            <th>Nepali Date</th>
                            <th>Check In</th>
                            <th>Check Out</th>
                            <th>Hours</th>
                            <th>Status</th>
                            <th>Shift</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr><td colspan="7" class="text-center text-muted py-4">No attendance in this period.</td></tr>
                        }
                        @foreach (var row in Model)
                        {
                            <tr>
                                <td>@row.Date.ToString("yyyy-MM-dd")</td>
                                <td>@row.NepaliDate</td>
                                <td>@(row.CheckInTime?.ToString("HH:mm") ?? "-")</td>
                                <td>@(row.CheckOutTime?.ToString("HH:mm") ?? "-")</td>
                                <td>@row.WorkingHours.ToString("0.0")</td>
                                <td>@row.Status</td>
                                <td>@(row.ShiftName ?? "-")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
