@model ZKAttendance.Domain.Entities.Department

@{
    ViewData["Title"] = "Edit Department";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="h3 font-weight-bold text-gray-800 mb-1">
                        <i class="bi bi-pencil-square text-warning me-2"></i> Edit Department
                    </h2>
                    <p class="text-muted mb-0">Update department details and structural hierarchy</p>
                </div>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Back to List
                </a>
            </div>

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-md-5">
                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="DepartmentId" />
                        <input type="hidden" asp-for="CreatedDate" />

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                <strong>Please fix the errors below:</strong>
                                <div asp-validation-summary="All" class="text-danger mt-1 small" style="list-style: none; padding-left: 0;"></div>
                            </div>
                        }

                        <div class="row g-3">
                            <div class="col-md-8">
                                <label asp-for="DepartmentName" class="form-label fw-semibold">Department Name <span class="text-danger">*</span></label>
                                <input asp-for="DepartmentName" class="form-control" required />
                                <span asp-validation-for="DepartmentName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="DepartmentCode" class="form-label fw-semibold">Department Code</label>
                                <input asp-for="DepartmentCode" class="form-control" />
                                <span asp-validation-for="DepartmentCode" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="ParentDepartmentId" class="form-label fw-semibold">Parent Department (Optional)</label>
                                <select asp-for="ParentDepartmentId" class="form-select" asp-items="ViewBag.ParentDepartments">
                                    <option value="">-- No Parent (Top-Level Department) --</option>
                                </select>
                            </div>

                            <div class="col-12">
                                <label asp-for="Description" class="form-label fw-semibold">Description / Notes</label>
                                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <div class="form-check form-switch mt-2">
                                    <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" id="isActiveSwitch" />
                                    <label class="form-check-label fw-semibold" for="isActiveSwitch">Active Department</label>
                                </div>
                            </div>
                        </div>

                        <hr class="my-4 text-muted opacity-25" />

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-light px-4">Cancel</a>
                            <button type="submit" class="btn btn-warning px-4">
                                <i class="bi bi-save me-1"></i> Update Department
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
