@model ZKAttendance.Domain.Entities.Department

@{
    ViewData["Title"] = "Department Details";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 font-weight-bold text-gray-800 mb-1">
                <i class="bi bi-info-circle text-primary me-2"></i> Department: @Model.DepartmentName
            </h2>
            <p class="text-muted mb-0">Overview of department information, sub-units, and staff members</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.DepartmentId" class="btn btn-warning">
                <i class="bi bi-pencil me-1"></i> Edit Department
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Back to List
            </a>
        </div>
    </div>

    <div class="row g-4">
        <!-- Details Card -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-0 pt-4 px-4 pb-0">
                    <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-building me-2 text-primary"></i> General Information</h5>
                </div>
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Department Name</span>
                        <span class="fw-bold text-dark">@Model.DepartmentName</span>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Code</span>
                        <span class="badge bg-light text-dark border font-monospace">@(string.IsNullOrEmpty(Model.DepartmentCode) ? "-" : Model.DepartmentCode)</span>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Parent Department</span>
                        <span class="fw-semibold text-dark">@(Model.ParentDepartment?.DepartmentName ?? "None (Top Level)")</span>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Status</span>
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Inactive</span>
                        }
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Created Date</span>
                        <span class="fw-semibold text-dark">@Model.CreatedDate.ToString("MMM dd, yyyy")</span>
                    </div>
                    <div class="pt-3">
                        <label class="text-muted small fw-bold text-uppercase d-block mb-1">Description</label>
                        <p class="text-dark bg-light p-3 rounded-3 mb-0 small">@(string.IsNullOrEmpty(Model.Description) ? "No description provided." : Model.Description)</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Employees in Department -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-0 pt-4 px-4 pb-0 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-people me-2 text-primary"></i> Assigned Employees (@(Model.Employees?.Count ?? 0))
                    </h5>
                    <a asp-controller="Employees" asp-action="Create" class="btn btn-sm btn-outline-primary rounded-pill">
                        <i class="bi bi-person-plus me-1"></i> Add Employee
                    </a>
                </div>
                <div class="card-body p-4">
                    @if (Model.Employees != null && Model.Employees.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Name</th>
                                        <th>Biometric ID</th>
                                        <th>Title / Position</th>
                                        <th class="text-center">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var emp in Model.Employees)
                                    {
                                        <tr>
                                            <td>
                                                <a asp-controller="Employees" asp-action="Details" asp-route-id="@emp.EmployeeId" class="text-decoration-none fw-semibold text-dark">
                                                    @emp.EmployeeName
                                                </a>
                                            </td>
                                            <td>
                                                <span class="badge bg-light text-dark border font-monospace">@emp.BiometricUserId</span>
                                            </td>
                                            <td>@(string.IsNullOrEmpty(emp.Title) ? "-" : emp.Title)</td>
                                            <td class="text-center">
                                                @if (emp.IsActive)
                                                {
                                                    <span class="badge bg-success-subtle text-success">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary-subtle text-secondary">Inactive</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-people fs-1 opacity-50 d-block mb-2"></i>
                            <h6>No employees currently assigned to this department.</h6>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
