@model ZKAttendance.Application.Dtos.DailyReportFilterViewModel

<h2>Daily Attendance Report</h2>

<form asp-action="DailyReportFilter" method="post" class="mb-4">
    <div class="row g-3">
        <div class="col-md-3">
            <label for="SelectedBranchId" class="form-label">Branch</label>
            <select asp-for="SelectedBranchId" class="form-select" asp-items="@(new SelectList(Model.Branches, "BranchId", "BranchName"))">
                <option value="">-- Select Branch --</option>
            </select>
        </div>

        <div class="col-md-3">
            <label for="SelectedDeviceId" class="form-label">Device</label>
            <select asp-for="SelectedDeviceId" class="form-select" asp-items="@(new SelectList(Model.Devices, "DeviceId", "DeviceName"))">
                <option value="">-- Select Device --</option>
            </select>
        </div>

        <div class="col-md-3">
            <label for="SelectedEmployeeId" class="form-label">Employee</label>
            <select asp-for="SelectedEmployeeId" class="form-select" asp-items="@(new SelectList(Model.Employees, "EmployeeId", "EmployeeName"))">
                <option value="">-- Select Employee --</option>
            </select>
        </div>

        <div class="col-md-3">
            <label class="form-label">From date</label>
            <input asp-for="DateFrom" type="date" class="form-control" />
        </div>

        <div class="col-md-3">
            <label class="form-label">To date</label>
            <input asp-for="DateTo" type="date" class="form-control" />
        </div>

        <div class="col-md-12 text-end mt-3">
            <button type="submit" class="btn btn-primary">Search</button>
        </div>
    </div>
</form>

@if (Model.Report != null && Model.Report.Items.Any())
{
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Employee Name</th>
                <th>Department</th>
                <th>First In</th>
                <th>Last Out</th>
                <th>Total Hours</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Report.Items)
            {
                <tr>
                    <td>@item.EmployeeName</td>
                    <td>@item.Department</td>
                    <td>@item.FirstCheckIn?.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@item.LastCheckOut?.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@(item.TotalWorkHours?.ToString(@"hh\:mm") ?? "-")</td>
                    <td>@item.Status</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">There are no records to display.</div>
}
