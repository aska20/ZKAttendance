@model ZKAttendance.Domain.Entities.WorkShift

@{
    ViewData["Title"] = "Shift Details";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="h3 font-weight-bold text-gray-800 mb-1">
                        <i class="bi bi-clock-history text-primary me-2"></i> Shift: @Model.ShiftName
                    </h2>
                    <p class="text-muted mb-0">Shift timing details and configuration</p>
                </div>
                <div class="d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.ShiftId" class="btn btn-warning">
                        <i class="bi bi-pencil me-1"></i> Edit Shift
                    </a>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Back to Shifts
                    </a>
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Shift Name</span>
                        <span class="fw-bold text-dark">@Model.ShiftName</span>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Start Time</span>
                        <span class="badge bg-light text-dark border">@DateTime.Today.Add(Model.StartTime).ToString("hh:mm tt")</span>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">End Time</span>
                        <span class="badge bg-light text-dark border">@DateTime.Today.Add(Model.EndTime).ToString("hh:mm tt")</span>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Late Grace Period</span>
                        <span class="fw-semibold text-warning">@Model.LateMinutes minutes</span>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Early Departure Grace</span>
                        <span class="fw-semibold text-warning">@Model.EarlyMinutes minutes</span>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Status</span>
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success-subtle text-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary-subtle text-secondary">Inactive</span>
                        }
                    </div>
                    <div class="pt-3">
                        <label class="text-muted small fw-bold text-uppercase d-block mb-1">Description</label>
                        <p class="text-dark bg-light p-3 rounded-3 mb-0 small">@(string.IsNullOrEmpty(Model.Description) ? "No description provided." : Model.Description)</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
