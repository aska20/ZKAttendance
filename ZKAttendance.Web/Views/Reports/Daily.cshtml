@model ZKAttendance.Application.Dtos.Reports.DailyAttendanceReportDto
@{
    ViewData["Title"] = "Daily Attendance Report";
    var branches = ViewBag.Branches as List<ZKAttendance.Domain.Entities.Branch> ?? new List<ZKAttendance.Domain.Entities.Branch>();
    var departments = ViewBag.Departments as List<ZKAttendance.Domain.Entities.Department> ?? new List<ZKAttendance.Domain.Entities.Department>();
    var selectedBranchId = ViewBag.SelectedBranchId as int?;
    var selectedDepartment = ViewBag.SelectedDepartment as string;
    var selectedDate = (DateTime)(ViewBag.SelectedDate ?? Model?.Date ?? DateTime.Today);
}

<div class="container-fluid py-3">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="h3 font-weight-bold text-gray-800 mb-1">
                <i class="bi bi-calendar-check text-primary me-2"></i> Daily Attendance Report
            </h2>
            <p class="text-muted mb-0">Overview of staff check-in, check-out, and daily presence for <strong>@selectedDate.ToString("dddd, MMMM dd, yyyy")</strong></p>
        </div>
        <div class="d-flex gap-2">
            <button onclick="window.print()" class="btn btn-outline-secondary shadow-sm">
                <i class="bi bi-printer me-1"></i> Print Report
            </button>
            <a asp-controller="Reports" asp-action="DailyReportFilter" class="btn btn-outline-primary shadow-sm">
                <i class="bi bi-sliders me-1"></i> Advanced Filter
            </a>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3 p-md-4">
            <form method="get" asp-controller="Reports" asp-action="Daily" id="filterForm" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label for="dateInput" class="form-label fw-semibold small text-muted">Attendance Date</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-calendar3"></i></span>
                        <input type="date" id="dateInput" name="date" value="@selectedDate.ToString("yyyy-MM-dd")" class="form-control border-start-0" />
                    </div>
                </div>

                <div class="col-md-3">
                    <label for="branchSelect" class="form-label fw-semibold small text-muted">Branch</label>
                    <select id="branchSelect" name="branchId" class="form-select">
                        <option value="">All Branches</option>
                        @foreach (var b in branches)
                        {
                            <option value="@b.BranchId" selected="@(selectedBranchId == b.BranchId)">@b.BranchName</option>
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <label for="deptSelect" class="form-label fw-semibold small text-muted">Department</label>
                    <select id="deptSelect" name="department" class="form-select">
                        <option value="">All Departments</option>
                        @foreach (var d in departments)
                        {
                            <option value="@d.DepartmentName" selected="@(selectedDepartment == d.DepartmentName)">@d.DepartmentName</option>
                        }
                    </select>
                </div>

                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-funnel me-1"></i> Apply Filter
                    </button>
                    <a asp-controller="Reports" asp-action="Daily" class="btn btn-light" title="Reset Filters">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- KPI Statistics Cards -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-body p-3 p-md-4">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted small text-uppercase fw-bold">Total Staff</span>
                            <h3 class="fw-bold text-dark mt-1 mb-0">@Model?.TotalEmployees</h3>
                        </div>
                        <div class="rounded-circle p-3 bg-primary-subtle text-primary" style="width: 50px; height: 50px; display: flex; align-items: center; justify-content: center;">
                            <i class="bi bi-people-fill fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-body p-3 p-md-4">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted small text-uppercase fw-bold">Present</span>
                            <h3 class="fw-bold text-success mt-1 mb-0">@Model?.PresentCount</h3>
                        </div>
                        <div class="rounded-circle p-3 bg-success-subtle text-success" style="width: 50px; height: 50px; display: flex; align-items: center; justify-content: center;">
                            <i class="bi bi-person-check-fill fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-body p-3 p-md-4">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted small text-uppercase fw-bold">Absent</span>
                            <h3 class="fw-bold text-danger mt-1 mb-0">@Model?.AbsentCount</h3>
                        </div>
                        <div class="rounded-circle p-3 bg-danger-subtle text-danger" style="width: 50px; height: 50px; display: flex; align-items: center; justify-content: center;">
                            <i class="bi bi-person-x-fill fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-body p-3 p-md-4">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="w-100 me-3">
                            <div class="d-flex justify-content-between">
                                <span class="text-muted small text-uppercase fw-bold">Attendance Rate</span>
                                <span class="fw-bold text-primary">@((Model?.AttendanceRate ?? 0).ToString("0.0"))%</span>
                            </div>
                            <div class="progress mt-2" style="height: 8px;">
                                <div class="progress-bar bg-primary progress-bar-striped progress-bar-animated" role="progressbar" style="width: @(Model?.AttendanceRate ?? 0)%" aria-valuenow="@(Model?.AttendanceRate ?? 0)" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        </div>
                        <div class="rounded-circle p-3 bg-info-subtle text-info" style="width: 50px; height: 50px; display: flex; align-items: center; justify-content: center;">
                            <i class="bi bi-pie-chart-fill fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Attendance Table Card -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white border-0 py-3 px-4 d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
            <h5 class="fw-bold mb-0">
                <i class="bi bi-list-check text-primary me-2"></i> Attendance Log Details
            </h5>
            <div style="max-width: 250px;">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search"></i></span>
                    <input type="text" id="tableSearch" class="form-control border-start-0" placeholder="Search employee..." />
                </div>
            </div>
        </div>

        <div class="table-responsive">
            @if (Model?.Items != null && Model.Items.Any())
            {
                <table class="table table-hover align-middle mb-0" id="attendanceTable">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Employee</th>
                            <th>Biometric ID</th>
                            <th>Department</th>
                            <th>First Check-In</th>
                            <th>Last Check-Out</th>
                            <th>Work Duration</th>
                            <th class="text-center pe-4">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-sm rounded-circle bg-light text-primary d-flex align-items-center justify-content-center fw-bold me-2" style="width: 34px; height: 34px; font-size: 13px;">
                                            @(string.IsNullOrEmpty(item.EmployeeName) ? "?" : item.EmployeeName.Substring(0, 1).ToUpper())
                                        </div>
                                        <span class="fw-semibold text-dark">@item.EmployeeName</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border font-12 font-monospace">@item.BiometricUserId</span>
                                </td>
                                <td>
                                    <span class="text-muted">@(string.IsNullOrEmpty(item.Department) ? "-" : item.Department)</span>
                                </td>
                                <td>
                                    @if (item.FirstCheckIn.HasValue)
                                    {
                                        <span class="text-dark fw-semibold"><i class="bi bi-box-arrow-in-right text-success me-1"></i> @item.FirstCheckIn.Value.ToString("hh:mm tt")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">--:--</span>
                                    }
                                </td>
                                <td>
                                    @if (item.LastCheckOut.HasValue)
                                    {
                                        <span class="text-dark fw-semibold"><i class="bi bi-box-arrow-right text-danger me-1"></i> @item.LastCheckOut.Value.ToString("hh:mm tt")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">--:--</span>
                                    }
                                </td>
                                <td>
                                    @if (item.TotalWorkHours.HasValue)
                                    {
                                        <span class="badge bg-light text-dark border fw-normal">
                                            <i class="bi bi-clock me-1 text-primary"></i> @($"{(int)item.TotalWorkHours.Value.TotalHours}h {item.TotalWorkHours.Value.Minutes:D2}m")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">--</span>
                                    }
                                </td>
                                <td class="text-center pe-4">
                                    @if (item.Status == "Present")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill font-12">
                                            <i class="bi bi-check-circle-fill me-1"></i> Present
                                        </span>
                                    }
                                    else if (item.Status == "No check-out")
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-3 py-2 rounded-pill font-12">
                                            <i class="bi bi-exclamation-circle-fill me-1"></i> No Check-out
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 rounded-pill font-12">
                                            <i class="bi bi-x-circle-fill me-1"></i> Absent
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="text-center py-5">
                    <div class="mx-auto mb-3" style="width: 60px; height: 60px; border-radius: 50%; background: #f1f5f9; display: flex; align-items: center; justify-content: center; color: #94a3b8; font-size: 28px;">
                        <i class="bi bi-inbox"></i>
                    </div>
                    <h6 class="fw-bold text-dark">No Attendance Records Found</h6>
                    <p class="text-muted small mb-0">There are no attendance records for the selected date and filters.</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Live client-side search in table
        document.getElementById('tableSearch')?.addEventListener('keyup', function () {
            const query = this.value.toLowerCase();
            const rows = document.querySelectorAll('#attendanceTable tbody tr');

            rows.forEach(row => {
                const text = row.innerText.toLowerCase();
                row.style.display = text.includes(query) ? '' : 'none';
            });
        });
    </script>
}
