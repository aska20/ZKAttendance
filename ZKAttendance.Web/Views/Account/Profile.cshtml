@model ZKAttendance.Web.Models.UserProfileViewModel
@{
    ViewData["Title"] = "User Profile & Security";
}

<div class="container-fluid py-4">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 font-weight-bold text-gray-800 mb-1">
                <i class="bi bi-person-badge text-primary me-2"></i> User Profile & Security
            </h2>
            <p class="text-muted mb-0">Manage your system credentials, role information, and password.</p>
        </div>
        <div>
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Profile Details Card -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4 text-center">
                    <div class="mx-auto mb-3" style="width: 80px; height: 80px; border-radius: 50%; background: linear-gradient(135deg, #3b82f6, #1d4ed8); color: white; display: flex; align-items: center; justify-content: center; font-size: 32px; font-weight: 700; box-shadow: 0 10px 20px rgba(59, 130, 246, 0.3);">
                        @(string.IsNullOrEmpty(Model.Username) ? "U" : Model.Username.Substring(0, 1).ToUpper())
                    </div>
                    <h4 class="card-title font-weight-bold mb-1">@Model.Username</h4>
                    <p class="text-muted mb-3">@Model.Email</p>

                    <div class="mb-4">
                        @if (Model.Role == "Admin")
                        {
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 rounded-pill font-13">
                                <i class="bi bi-shield-shaded me-1"></i> System Administrator
                            </span>
                        }
                        else if (Model.Role == "HR")
                        {
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill font-13">
                                <i class="bi bi-person-check-fill me-1"></i> HR Officer
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-info-subtle text-info border border-info-subtle px-3 py-2 rounded-pill font-13">
                                <i class="bi bi-person me-1"></i> @Model.Role
                            </span>
                        }
                    </div>

                    <hr class="my-4 text-muted opacity-25" />

                    <div class="text-start px-2">
                        <div class="d-flex justify-content-between py-2 border-bottom">
                            <span class="text-muted"><i class="bi bi-toggle-on me-2"></i> Account Status</span>
                            <span class="badge bg-success-subtle text-success">Active</span>
                        </div>
                        <div class="d-flex justify-content-between py-2 border-bottom">
                            <span class="text-muted"><i class="bi bi-calendar-event me-2"></i> Member Since</span>
                            <span class="fw-semibold text-dark">@Model.CreatedDate.ToString("MMM dd, yyyy")</span>
                        </div>
                        <div class="d-flex justify-content-between py-2 border-bottom">
                            <span class="text-muted"><i class="bi bi-clock-history me-2"></i> Last Login</span>
                            <span class="fw-semibold text-dark">@(Model.LastLoginDate.HasValue ? Model.LastLoginDate.Value.ToString("g") : "Current Session")</span>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.EmployeeName))
                        {
                            <div class="d-flex justify-content-between py-2 border-bottom">
                                <span class="text-muted"><i class="bi bi-person-badge me-2"></i> Linked Employee</span>
                                <span class="fw-semibold text-dark">@Model.EmployeeName</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.DepartmentName))
                        {
                            <div class="d-flex justify-content-between py-2">
                                <span class="text-muted"><i class="bi bi-building me-2"></i> Department</span>
                                <span class="fw-semibold text-dark">@Model.DepartmentName</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Change Password Card -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-0 pt-4 px-4 pb-0">
                    <h5 class="fw-bold mb-1"><i class="bi bi-key-fill text-warning me-2"></i> Change Password</h5>
                    <p class="text-muted small">Ensure your account uses a secure password of at least 6 characters.</p>
                </div>
                <div class="card-body p-4">
                    <form asp-controller="Account" asp-action="ChangePassword" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label fw-semibold" for="CurrentPassword">Current Password</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-lock"></i></span>
                                <input type="password" name="CurrentPassword" id="CurrentPassword" class="form-control border-start-0" placeholder="Enter your current password" required />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold" for="NewPassword">New Password</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-shield-lock"></i></span>
                                <input type="password" name="NewPassword" id="NewPassword" class="form-control border-start-0" placeholder="Enter new password (min 6 characters)" required minlength="6" />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold" for="ConfirmNewPassword">Confirm New Password</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-shield-check"></i></span>
                                <input type="password" name="ConfirmNewPassword" id="ConfirmNewPassword" class="form-control border-start-0" placeholder="Re-enter new password" required minlength="6" />
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <button type="reset" class="btn btn-light px-4">Reset</button>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-save me-1"></i> Update Password
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
