@model List<ZKAttendance.Domain.Entities.WorkShift>

@{
    ViewData["Title"] = "Work Shifts";
}

<style>
    .page-header-shift {
        background: linear-gradient(135deg, #4f46e5 0%, #3730a3 100%);
        color: white;
        padding: 2rem;
        border-radius: 16px;
        margin-bottom: 2rem;
        box-shadow: 0 10px 25px rgba(79, 70, 229, 0.2);
    }
</style>

<div class="container-fluid py-3">
    <!-- Header -->
    <div class="page-header-shift">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
                <h2 class="mb-1 fw-bold">
                    <i class="bi bi-clock-history me-2"></i> Work Shifts
                </h2>
                <p class="mb-0 opacity-75">Configure working hours, shifts, grace periods, and late thresholds</p>
            </div>
            <a asp-action="Create" class="btn btn-light btn-lg rounded-pill px-4 shadow-sm text-primary fw-semibold">
                <i class="bi bi-plus-circle me-1"></i> Add Shift
            </a>
        </div>
    </div>

    <!-- Table Card -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="p-3 px-4 bg-white border-bottom d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0 text-dark">
                <i class="bi bi-list-check text-primary me-2"></i> Configured Shifts
            </h5>
            <span class="badge bg-light text-dark border">@Model.Count Total Shifts</span>
        </div>

        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Shift Name</th>
                            <th>Timing</th>
                            <th>Total Duration</th>
                            <th>Late Grace</th>
                            <th>Early Leave Grace</th>
                            <th class="text-center">Status</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <strong class="text-dark">@s.ShiftName</strong>
                                    @if (!string.IsNullOrEmpty(s.Description))
                                    {
                                        <div class="text-muted small">@s.Description</div>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        <i class="bi bi-clock me-1 text-primary"></i>
                                        @DateTime.Today.Add(s.StartTime).ToString("hh:mm tt") - @DateTime.Today.Add(s.EndTime).ToString("hh:mm tt")
                                    </span>
                                </td>
                                <td>
                                    <span>@(s.WorkMinutes / 60)h @(s.WorkMinutes % 60)m</span>
                                </td>
                                <td>
                                    <span class="text-warning fw-semibold">@s.LateMinutes mins</span>
                                </td>
                                <td>
                                    <span class="text-warning fw-semibold">@s.EarlyMinutes mins</span>
                                </td>
                                <td class="text-center">
                                    @if (s.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill font-12">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-3 py-2 rounded-pill font-12">Inactive</span>
                                    }
                                </td>
                                <td class="pe-4 text-end">
                                    <div class="d-flex justify-content-end gap-1">
                                        <a asp-action="Details" asp-route-id="@s.ShiftId" class="btn btn-sm btn-outline-info" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@s.ShiftId" class="btn btn-sm btn-outline-warning" title="Edit Shift">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@s.ShiftId" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this shift?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Shift">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-clock-history fs-1 opacity-50 d-block mb-2"></i>
                <h6>No work shifts configured yet.</h6>
                <a asp-action="Create" class="btn btn-primary mt-2 rounded-pill">
                    <i class="bi bi-plus-circle me-1"></i> Add Default Shift
                </a>
            </div>
        }
    </div>
</div>
